# Server
HOST=127.0.0.1
PORT=7781
LOG_LEVEL=info

# Public base URL — used for share links in the UI
PUBLIC_BASE_URL=https://games.djiang.xyz

# Persistence (empty = in-memory / disabled, lost on restart)
ACCOUNTS_DB_PATH=/opt/games/data/accounts.db
CHESS_DB_PATH=/opt/games/data/chess.db

# --- Discord OAuth (optional login for leaderboards; guests always play) ---
# Base URL for the OAuth redirect + cookie Secure flag.
WEB_BASE_URL=https://games.djiang.xyz
# Create an app at https://discord.com/developers and register redirect URI:
#   https://games.djiang.xyz/auth/discord/callback
# Leave client id empty to disable login entirely.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=   # optional; defaults to {WEB_BASE_URL}/auth/discord/callback
# Long random string — signs session + guest cookies.
SESSION_SECRET=change-me-to-a-long-random-string
